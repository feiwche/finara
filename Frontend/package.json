{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-all": "concurrently \"ng serve backoffice\" \"ng serve client\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test client && ng test backoffice && ng test shared-ui",
    "serve:ssr:client": "node dist/client/server/server.mjs",
    "serve:ssr:backoffice": "node dist/backoffice/server/server.mjs",
    "generate:api-client": "curl -s http://localhost:5068/swagger/v1/swagger.json -o swagger.json && nswag openapi2tsclient /input:swagger.json /output:projects/shared-ui/src/lib/api/finara-client.ts /template:Angular /rxJsVersion:7.0 /injectionTokenType:InjectionToken /generateClientClasses:true /generateOptionalParameters:true /markOptionalProperties:true /nullValue:Undefined"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/platform-server": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@angular/ssr": "^19.2.27",
    "@microsoft/signalr": "^10.0.0",
    "@primeng/themes": "19.1.4",
    "chart.js": "^4.5.1",
    "express": "^4.18.2",
    "primeicons": "^8.0.0",
    "primeng": "19.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.25",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.18.0",
    "concurrently": "^9.2.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ng-packagr": "^19.2.2",
    "nswag": "^14.7.1",
    "typescript": "~5.5.2"
  }
}
