{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-all": "concurrently \"ng serve backoffice --port 4300\" \"ng serve client --port 4200\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test client && ng test backoffice && ng test shared-ui",
    "test:e2e": "playwright test",
    "serve:ssr:client": "node dist/client/server/server.mjs",
    "serve:ssr:backoffice": "node dist/backoffice/server/server.mjs",
    "generate:api-client": "curl -s http://localhost:5068/swagger/v1/swagger.json -o swagger.json && nswag openapi2tsclient /input:swagger.json /output:projects/shared-ui/src/lib/api/finara-client.ts /template:Angular /rxJsVersion:7.0 /injectionTokenType:InjectionToken /generateClientClasses:true /generateOptionalParameters:true /markOptionalProperties:true /nullValue:Undefined"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.31",
    "@angular/common": "^20.3.31",
    "@angular/compiler": "^20.3.31",
    "@angular/core": "^20.3.31",
    "@angular/forms": "^20.3.31",
    "@angular/platform-browser": "^20.3.31",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/platform-server": "^20.3.31",
    "@angular/router": "^20.3.31",
    "@angular/ssr": "^20.3.32",
    "@microsoft/signalr": "^10.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@primeng/themes": "^20.4.0",
    "chart.js": "^4.5.1",
    "express": "^4.18.2",
    "primeicons": "^8.0.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.31",
    "@playwright/test": "^1.62.0",
    "@types/express": "^4.17.17",
    "@types/node": "^18.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.4",
    "jsdom": "^30.0.1",
    "ng-packagr": "^20.3.2",
    "nswag": "^14.7.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
