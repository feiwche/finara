{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "Finara.Api",
    "Audience": "Finara.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "Key": ""
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.1:8b",
    "TimeoutSeconds": 300
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Notifications": {
    "Email": {
      "Provider": "Mock"
    },
    "Sms": {
      "Provider": "Mock"
    }
  },
  "Automation": {
    "Enabled": true,
    "IntervalMinutes": 30,
    "MaxOffersPerCustomer": 5
  },
  "WeeklyDigest": {
    "Enabled": true,
    "CheckIntervalMinutes": 360
  },
  "AutomationWatchdog": {
    "Enabled": true,
    "CheckIntervalMinutes": 15
  },
  "ExchangeRates": {
    "BaseCurrency": "TRY",
    "RatesToBase": {
      "USD": 35,
      "EUR": 38
    }
  },
  "LogRetention": {
    "Enabled": true,
    "CheckIntervalHours": 24,
    "AuditLogRetentionDays": 730,
    "NotificationLogRetentionDays": 365,
    "AiInteractionLogRetentionDays": 90,
    "DeleteBatchSize": 1000
  }
}
